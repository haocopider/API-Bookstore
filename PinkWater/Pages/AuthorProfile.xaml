<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PinkWater.Pages.AuthorProfile"
             Title="AuthorProfile">
    <ScrollView>
        <VerticalStackLayout Spacing="8">

            <Grid BackgroundColor="White" Padding="20">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFEFE5" Offset="0.0" />
                        <GradientStop Color="White" Offset="1.0" />
                    </LinearGradientBrush>
                </Grid.Background>

                <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                    <Border HeightRequest="100" WidthRequest="100" HorizontalOptions="Center">
                        <Image Source="https://via.placeholder.com/100" Aspect="AspectFill" />
                    </Border>

                    <Label Text="Vũ Trọng Phụng" FontSize="20" FontAttributes="Bold" TextColor="#222" HorizontalOptions="Center" />
                    <Label Text="14 Tác phẩm | 2.5k Người theo dõi" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />

                    <Button Text="+ Theo dõi" BackgroundColor="#EE4D2D" TextColor="White" HeightRequest="35" WidthRequest="120" CornerRadius="4" Margin="0,5,0,0" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout BackgroundColor="White" Padding="15">
                <Label Text="Tiểu sử" FontAttributes="Bold" FontSize="16" Margin="0,0,0,10" />
                <Label Text="Được mệnh danh là 'Ông vua phóng sự đất Bắc', Vũ Trọng Phụng là một trong những nhà văn hiện thực xuất sắc nhất của văn học Việt Nam trước năm 1945..." 
                       TextColor="#444" LineHeight="1.4" MaxLines="3" LineBreakMode="TailTruncation" />
                <Label Text="Xem thêm" TextColor="#00B0FF" FontSize="12" Margin="0,5,0,0" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout BackgroundColor="White" Padding="10">
                <Label Text="Tác phẩm nổi bật" FontAttributes="Bold" FontSize="16" Margin="5,5,0,10" />

                <CollectionView ItemsSource="{Binding AuthorBooks}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="#F9F9F9" Padding="0" Margin="2">
                                <VerticalStackLayout Spacing="5">
                                    <Image Source="https://via.placeholder.com/150x200" HeightRequest="180" Aspect="AspectFill" />
                                    <VerticalStackLayout Padding="8">
                                        <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" MaxLines="2" LineBreakMode="TailTruncation" HeightRequest="40" />
                                        <Label Text="{Binding MinPrice, StringFormat='{0:N0} ₫'}" FontSize="16" TextColor="#EE4D2D" FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>