@* @page "/change-password"
@attribute [Authorize]

<PageTitle>Đổi mật khẩu</PageTitle>

        <div class="flex-grow-1 container-p-y">
            <div class="row">
                <div class="col-md-12">
                    <ul class="nav nav-pills flex-column flex-md-row mb-3">
                        <li class="nav-item">
                            <a class="nav-link active" href="/profile"><i class="bx bx-user me-1"></i> Tài khoản</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/change-password"><i class="bx bx-bell me-1"></i>Đổi mật khẩu</a>
                        </li>
                    </ul>
                    <div class="card mb-4">
                            <h5 class="card-header">Đổi mật khẩu</h5>
    @if (userHasPasscode == null)
    {
        <div class="text-center py-4">
            <div class="spinner-border text-primary"></div>
        </div>

    }

    else if (userHasPasscode == false)
    {
        <div class="text-center py-4">
            <i class="bx bx-shield-x display-1 text-warning mb-3"></i>
            <h5 class="fw-bold">Chưa thiết lập Passcode!</h5>
            <p class="text-muted">Bạn cần thiết lập mã Passcode 6 số để có thể sử dụng chức năng đổi mật khẩu này.</p>
            <button class="btn btn-primary rounded-pill px-4" @onclick='() => Navigation.NavigateTo("/profile")'>
                <i class="bx bx-user me-1"></i> Thiết lập ngay tại hồ sơ
            </button>
        </div>
    }
    else
    {
        <div class="text-center mb-4">
            <i class="bx bx-lock-open-alt display-4 text-primary"></i>
            <p class="text-muted mt-2">Nhập mã PIN 6 số và mật khẩu mới của bạn</p>
        </div>

        <EditForm Model="changeModel" OnValidSubmit="HandleChangePassword">
            <DataAnnotationsValidator />
            <ValidationSummary></ValidationSummary>
            <div class="mb-4">
                <label class="form-label fw-bold">Mã xác thực Passcode (6 số)</label>
                <InputText maxlength="6" @bind-Value="changeModel.CurrentPasscode"
                           class="form-control text-center fs-2 fw-bold letter-spacing-10"
                           placeholder="******" />
                <ValidationMessage For="@(() => changeModel.CurrentPasscode)" class="text-danger small" />
            </div>

            <div class="mb-3">
                <label class="form-label">Mật khẩu mới</label>
                <div class="input-group input-group-merge">
                    <span class="input-group-text"><i class="bx bx-key"></i></span>
                    <InputText type="password" @bind-Value="changeModel.NewPassword" class="form-control" placeholder="Tối thiểu 6 ký tự" />
                </div>
                <ValidationMessage For="@(() => changeModel.NewPassword)" class="text-danger small" />
            </div>

            <div class="mb-3">
                <label class="form-label">Xác nhận mật khẩu mới</label>
                <div class="input-group input-group-merge">
                    <span class="input-group-text"><i class="bx bx-check-double"></i></span>
                    <InputText type="password" @bind-Value="changeModel.ConfirmNewPassword" class="form-control" placeholder="Nhập lại mật khẩu mới" />
                </div>
                <ValidationMessage For="@(() => changeModel.ConfirmNewPassword)" class="text-danger small" />
            </div>

            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <div class="alert alert-danger d-flex align-items-center" role="alert">
                    <i class="bx bx-error-circle me-2"></i>
                    <div>@errorMsg</div>
                </div>
            }

            <div class="mt-4">
                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold rounded-pill shadow-sm" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    Xác nhận cập nhật
                </button>
            </div>
        </EditForm>
    }
</div>

</div>
</div>
</div>

<style>
    .letter-spacing-10 {
        letter-spacing: 8px;
    }
</style>

@code {
    private ChangePasswordDto changeModel = new();
    private bool? userHasPasscode = null;
    private bool isSubmitting = false;
    private string? errorMsg;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            userHasPasscode = await Http.GetFromJsonAsync<bool>("api/accounts/has-passcode");
        }
        catch
        {
            userHasPasscode = false;
        }
    }

    private async Task HandleChangePassword()
    {
        isSubmitting = true;
        errorMsg = null;

        var res = await Http.PostAsJsonAsync("api/accounts/change-password-secure", changeModel);

        if (res.IsSuccessStatusCode)
        {
            NotificationService.Success("Mật khẩu đã được thay đổi thành công!");
            Navigation.NavigateTo("/profile");
        }
        else
        {
            var content = await res.Content.ReadAsStringAsync();
            errorMsg = content.Contains("Mã Passcode không chính xác") ? "Mã Passcode không đúng. Vui lòng thử lại!" : "Có lỗi xảy ra, vui lòng kiểm tra lại thông tin.";
        }
        isSubmitting = false;
    }
} *@