@* @page "/forgot-password"

<PageTitle>Quên mật khẩu</PageTitle>

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh; margin-top: 20px;">
    <div class="card shadow-lg p-4 border-0" style="max-width: 450px; width: 100%; border-radius: 16px;">

        <div class="text-center mb-4">
            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                <i class="bx bx-lock-alt fs-1"></i>
            </div>
            <h4 class="fw-bold">@GetTitle()</h4>
            <p class="text-muted small">@GetDescription()</p>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger d-flex align-items-center p-2 mb-3 small" role="alert">
                <i class="bx bx-error-circle me-2"></i> @ErrorMessage
            </div>
        }

        @if (CurrentStep == 1)
        {
            <EditForm Model="forgotDto" OnValidSubmit="HandleSendOtp">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label">Email đăng ký</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bx bx-envelope"></i></span>
                        <InputText @bind-Value="forgotDto.Email" class="form-control" placeholder="nhap@email.com" />
                    </div>
                    <ValidationMessage For="@(() => forgotDto.Email)" />
                </div>
                <button type="submit" class="btn btn-primary w-100 py-2" disabled="@IsLoading">
                    @if (IsLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    Gửi mã xác thực
                </button>
            </EditForm>
            <div class="text-center mt-3">
                <a href="/login" class="text-decoration-none small text-muted"><i class="bx bx-arrow-back"></i> Quay lại đăng nhập</a>
            </div>
        }

        else if (CurrentStep == 2)
        {
            <EditForm Model="verifyDto" OnValidSubmit="HandleVerifyOtp">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label">Mã OTP (6 số)</label>
                    <InputText @bind-Value="verifyDto.Otp" class="form-control text-center fw-bold fs-4" maxlength="6" placeholder="000000" />
                    <ValidationMessage For="@(() => verifyDto.Otp)" />
                </div>
                <button type="submit" class="btn btn-primary w-100 py-2 mb-2" disabled="@IsLoading">
                    @if (IsLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    Xác thực
                </button>
                <button type="button" class="btn btn-light w-100 btn-sm text-muted" @onclick="() => CurrentStep = 1">
                    Gửi lại mã / Nhập lại Email
                </button>
            </EditForm>
        }


        else if (CurrentStep == 3)
        {
            <EditForm Model="resetDto" OnValidSubmit="HandleResetPassword">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label">Mật khẩu mới</label>
                    <InputText type="password" @bind-Value="resetDto.NewPassword" class="form-control" />
                    <ValidationMessage For="@(() => resetDto.NewPassword)" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Xác nhận mật khẩu</label>
                    <InputText type="password" @bind-Value="resetDto.ConfirmNewPassword" class="form-control" />
                    <ValidationMessage For="@(() => resetDto.ConfirmNewPassword)" />
                </div>
                <button type="submit" class="btn btn-success w-100 py-2" disabled="@IsLoading">
                    @if (IsLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    Đổi mật khẩu
                </button>
            </EditForm>
        }
    </div>
</div>

@code {
    private int CurrentStep = 1; // 1: Email, 2: OTP, 3: New Pass
    private bool IsLoading = false;
    private string ErrorMessage = "";

    // Models
    private ForgotPasswordDto forgotDto = new();
    private VerifyOtpDto verifyDto = new();
    private ResetPasswordDto resetDto = new();

    // Text Helper
    private string GetTitle() => CurrentStep switch
    {
        1 => "Quên mật khẩu?",
        2 => "Xác thực OTP",
        3 => "Đặt lại mật khẩu",
        _ => ""
    };

    private string GetDescription() => CurrentStep switch
    {
        1 => "Nhập email của bạn và chúng tôi sẽ gửi mã OTP để đặt lại mật khẩu.",
        2 => $"Mã OTP đã được gửi tới {forgotDto.Email}. Vui lòng kiểm tra hộp thư.",
        3 => "Thiết lập mật khẩu mới cho tài khoản của bạn.",
        _ => ""
    };

    // --- STEP 1: Gửi OTP ---
    private async Task HandleSendOtp()
    {
        IsLoading = true;
        ErrorMessage = "";
        try
        {
            var response = await Http.PostAsJsonAsync("api/accounts/forgot-password-request", forgotDto);
            if (response.IsSuccessStatusCode)
            {
                verifyDto.Email = forgotDto.Email;
                CurrentStep = 2;
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ErrorMessage = error.Contains("EMAIL_NOT_FOUND") ? "Email này chưa được đăng ký." : "Lỗi gửi mail, vui lòng thử lại.";
                NotificationService.Error(ErrorMessage);
            }
        }
        catch { ErrorMessage = "Lỗi kết nối máy chủ."; }
        finally { IsLoading = false; }
    }

    // --- STEP 2: Verify OTP ---
    private async Task HandleVerifyOtp()
    {
        IsLoading = true;
        ErrorMessage = "";
        try
        {
            var response = await Http.PostAsJsonAsync("api/accounts/verify-otp", verifyDto);
            if (response.IsSuccessStatusCode)
            {
                // Chuyển sang bước 3, copy email và otp sang dto reset (để gửi lên server check lần cuối)
                resetDto.Email = verifyDto.Email;
                resetDto.Otp = verifyDto.Otp;
                CurrentStep = 3;
            }
            else
            {
                ErrorMessage = "Mã OTP không chính xác hoặc đã hết hạn.";
                NotificationService.Error(ErrorMessage);
            }
        }
        catch { ErrorMessage = "Lỗi kết nối."; }
        finally { IsLoading = false; }
    }

    // --- STEP 3: Reset Password ---
    private async Task HandleResetPassword()
    {
        IsLoading = true;
        ErrorMessage = "";
        try
        {
            var response = await Http.PostAsJsonAsync("api/accounts/reset-password", resetDto);
            if (response.IsSuccessStatusCode)
            {
                // Thành công -> Chuyển về Login
                NotificationService.Success("Đặt lại mật khẩu thành công. Vui lòng đăng nhập lại.");
                Navigation.NavigateTo("/login?reset=success");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                if (error.Contains("OTP_INVALID"))
                {
                    ErrorMessage = "Phiên OTP đã hết hạn, vui lòng làm lại từ đầu.";
                    CurrentStep = 1; // Reset về đầu
                }
                else
                {
                    ErrorMessage = "Đã có lỗi xảy ra. Vui lòng thử lại.";
                }
                NotificationService.Error(ErrorMessage);
            }
        }
        catch { ErrorMessage = "Lỗi kết nối."; }
        finally { IsLoading = false; }
    }
} *@