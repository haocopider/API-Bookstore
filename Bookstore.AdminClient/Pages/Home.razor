@page "/"

<PageTitle>Tổng quan</PageTitle>

<div class="card-header d-flex align-items-center justify-content-between border-bottom">
    <h5 class="card-title m-0 fw-bold text-primary">Biểu đồ doanh thu năm @DateTime.Now.Year</h5>
</div>
@if (isLoading)
{
    <div class="p-5 text-center"><div class="spinner-border text-primary"></div></div>
}
else if (summary == null)
{
    <div class="p-5 text-center text-muted">Không thể tải dữ liệu tổng quan.</div>
}
else
{
    <div class="card-body p-4">
        <div class="w-100 mt-4" style="position: relative; height: 500px;">
            <canvas id="MixedChart"></canvas>
        </div>

        <div class="hint_container d-flex justify-content-center mt-3">
            <div class="d-flex align-items-center me-4">
                <div class="hint_chart" style="background-color: rgba(0, 128, 0, 0.7); width: 20px; height: 20px;"></div>
                <span class="ms-2 fw-bold text-success">Doanh thu</span>
            </div>

            <div class="d-flex align-items-center">
                <div class="hint_chart" style="background-color: rgba(0, 0, 255, 0.7); width: 20px; height: 20px;"></div>
                <span class="ms-2 fw-bold text-primary">Đơn hàng</span>
            </div>
        </div>

        <div class="mt-5">
            <h5 class="fw-bold mb-3 text-primary"><i class="bx bx-table me-2"></i>Chi tiết thống kê sản phẩm</h5>
            <div class="table-responsive shadow-sm rounded">
                <table class="table table-hover table-bordered mb-0 align-middle">
                    <thead class="table-primary text-center">
                        <tr>
                            <th style="width: 5%;">STT</th>

                            <th style="width: 40%; cursor: pointer;" @onclick="() => SortTable(SortColumn.Name)">
                                Tên sản phẩm
                                <i class="@GetSortIcon(SortColumn.Name) ms-1"></i>
                            </th>

                            <th style="width: 25%; cursor: pointer;" @onclick="() => SortTable(SortColumn.Quantity)">
                                Đã bán / Tồn kho
                                <i class="@GetSortIcon(SortColumn.Quantity) ms-1"></i>
                            </th>

                            <th style="width: 30%; cursor: pointer;" @onclick="() => SortTable(SortColumn.Revenue)">
                                Doanh thu
                                <i class="@GetSortIcon(SortColumn.Revenue) ms-1"></i>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (SortedProducts == null || !SortedProducts.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-3">Không có dữ liệu</td>
                            </tr>
                        }
                        else
                        {
                            int index = 1;
                            @foreach (var item in SortedProducts)
                            {
                                <tr>
                                    <td class="text-center">@index</td>
                                    <td class="fw-semibold">@item.ProductName</td>
                                    <td class="text-center">
                                        <span class="text-success fw-bold">@item.SoldQuantity</span>
                                        <span class="text-muted">/ @item.StockQuantity</span>
                                    </td>
                                    <td class="text-end fw-bold text-danger">
                                        @item.Revenue.ToString("N0") VNĐ
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="2" class="text-end text-uppercase">Tổng cộng:</td>
                            <td class="text-center text-success fs-6">
                                @TotalSoldQuantity <span class="text-muted fw-normal">/ @TotalStockQuantity</span>
                            </td>
                            <td class="text-end text-danger fs-6">
                                @TotalRevenue.ToString("N0") VNĐ
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}


   
<style>
    .cursor-pointer {
        cursor: pointer;
    }

    .bg-label-hover-primary:hover {
        background-color: #e7e7ff !important;
        border-color: #696cff !important;
    }

    .bg-label-hover-success:hover {
        background-color: #e8fadf !important;
        border-color: #71dd37 !important;
    }

    .bg-label-hover-info:hover {
        background-color: #d7f5fc !important;
        border-color: #03c3ec !important;
    }

    .bg-label-hover-warning:hover {
        background-color: #fff2d6 !important;
        border-color: #ffab00 !important;
    }

    .transition-all {
        transition: all 0.2s ease-in-out;
    }

    .object-fit-cover {
        object-fit: cover;
    }

    /* Nút chat trôi nổi (Floating Button) */
    .chat-float-btn {
        position: fixed;
        bottom: 30px; /* Cách lề dưới 30px */
        right: 30px; /* Cách lề phải 30px */
        width: 60px; /* Chiều rộng nút */
        height: 60px; /* Chiều cao nút */
        border-radius: 50%; /* Bo tròn hoàn toàn */
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050; /* Đảm bảo nút luôn nổi lên trên các thành phần khác */
        transition: all 0.3s ease; /* Hiệu ứng chuyển động mượt mà */
    }

        /* Hiệu ứng khi di chuột vào nút */
        .chat-float-btn:hover {
            transform: scale(1.1); /* Phóng to nút lên 10% */
            cursor: pointer;
        }
</style>

<script>
    window.renderCombinedChart = (labels, revenues, orders) => {
        if (window.mixedChart) window.mixedChart.destroy();

        const ctx = document.getElementById("MixedChart");

        window.mixedChart = new Chart(ctx, {
            type: "bar",
            data: {
                labels: labels,
                datasets: [
                    {
                        label: "Doanh thu (VNĐ)",
                        data: revenues,
                        backgroundColor: "rgba(0, 128, 0, 0.7)",
                        borderColor: "rgba(0, 128, 0, 1)",
                        borderWidth: 1,
                        borderRadius: 4,
                        order: 2,
                        yAxisID: 'y', // Gắn vào trục Y bên trái
                    },
                    {
                        label: "Đơn hàng",
                        data: orders,
                        backgroundColor: "rgba(0, 0, 255, 0.7)",
                        borderColor: "rgba(0, 0, 255, 1)",
                        borderWidth: 1,
                        borderRadius: 4,
                        order: 1,
                        yAxisID: 'y1',
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false,
                },
                plugins: {
                    legend: {
                        display: true, // Hiển thị chú thích của ChartJS
                        position: 'top'
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                let label = context.dataset.label || '';
                                if (label) {
                                    label += ': ';
                                }
                                if (context.parsed.y !== null) {
                                    // Format tiền nếu là dataset Doanh thu
                                    if(context.dataset.yAxisID === 'y') {
                                         label += new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(context.parsed.y);
                                    } else {
                                         label += context.parsed.y;
                                    }
                                }
                                return label;
                            }
                        }
                    }
                },
                scales: {
                    // Cấu hình trục Y trái (Doanh thu)
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        title: {
                            display: true,
                            text: 'Doanh thu (VNĐ)'
                        },
                        ticks: {
                            callback: function(value) {
                                // Rút gọn số hiển thị trục cho đỡ rối (VD: 1tr)
                                if (value >= 1000000) return (value / 1000000) + 'tr';
                                if (value >= 1000) return (value / 1000) + 'k';
                                return value;
                            }
                        }
                    },
                    // Cấu hình trục Y phải (Đơn hàng)
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        title: {
                            display: true,
                            text: 'Số đơn'
                        },
                        grid: {
                            drawOnChartArea: false,
                        },
                        suggestedMax: 10, // Nếu số đơn < 10, trục Y vẫn sẽ cao tới 10. Nếu > 10, nó tự dãn ra.
                        beginAtZero: true,
                        ticks: {
                            precision: 0, // Chỉ hiện số nguyên (bỏ 0.5, 1.5...)
                            stepSize: 1   // Khoảng cách mỗi vạch là 1 đơn vị
                        }
                        // --- KẾT THÚC CHỈNH SỬA ---
                    },
                    x: {
                        grid: {
                            display: false // Tùy chọn: ẩn lưới dọc
                        }
                    }
                }
            }
        });
    };
</script>

@code {
    private MonthlyRevenueDto summary { get; set; }
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!(authState.User?.Identity?.IsAuthenticated ?? false))
        {
            isLoading = false;
            NotificationService.Warning("Vui lòng đăng nhập để xem dữ liệu.");
            return;
        }

        await LoadDashboardSummary();
    }

    private async Task LoadDashboardSummary()
    {
        isLoading = true;
        try
        {
            summary = await Http.GetFromJsonAsync<MonthlyRevenueDto>("api/statistics/dashboard-summary");
        }
        catch (Exception ex)
        {
            Console.WriteLine("Lỗi tải dữ liệu tổng quan: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private List<ProductStatDto> _rawProducts = new();

    // Enum định nghĩa các cột có thể sắp xếp
    private enum SortColumn { Name, Quantity, Revenue }
    private SortColumn _currentSortColumn = SortColumn.Revenue;
    private bool _isAscending = false;

    private int TotalSoldQuantity => _rawProducts?.Sum(p => p.SoldQuantity) ?? 0;
    private int TotalStockQuantity => _rawProducts?.Sum(p => p.StockQuantity) ?? 0;
    private decimal TotalRevenue => _rawProducts?.Sum(p => p.Revenue) ?? 0;

    private IEnumerable<ProductStatDto> SortedProducts
    {
        get
        {
            if (_rawProducts == null) return Array.Empty<ProductStatDto>();

            return _currentSortColumn switch
            {
                SortColumn.Name => _isAscending
                    ? _rawProducts.OrderBy(x => x.ProductName)
                    : _rawProducts.OrderByDescending(x => x.ProductName),

                SortColumn.Quantity => _isAscending
                                    ? _rawProducts.OrderBy(x => x.SoldQuantity)
                                    : _rawProducts.OrderByDescending(x => x.SoldQuantity),

                SortColumn.Revenue => _isAscending
                                    ? _rawProducts.OrderBy(x => x.Revenue)
                                    : _rawProducts.OrderByDescending(x => x.Revenue),

                _ => _rawProducts
            };
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (summary?.RevenueChartData != null)
        {
            // Code render chart của bạn giữ nguyên
            var labels = summary.RevenueChartData.Select(x => x.MonthLabel).ToArray();
            var revenues = summary.RevenueChartData.Select(x => x.Revenue).ToArray();
            var orders = summary.RevenueChartData.Select(x => x.OrderCount).ToArray();

            await JSR.InvokeVoidAsync("renderCombinedChart", labels, revenues, orders);
        }
    }

    protected override void OnParametersSet()
    {
        if (summary?.ProductStats != null)
        {
            _rawProducts = summary.ProductStats;
        }
    }

    private void SortTable(SortColumn column)
    {
        if (_currentSortColumn == column)
        {
            _isAscending = !_isAscending;
        }
        else
        {
            _currentSortColumn = column;
            _isAscending = false;
        }
    }

    private string GetSortIcon(SortColumn column)
    {
        if (_currentSortColumn != column) return "bx bx-sort text-white-50";

        return _isAscending ? "bx bx-sort-up text-white" : "bx bx-sort-down text-white";
    }
}
