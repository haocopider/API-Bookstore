
<div class="card mb-4 shadow-sm border-0">
    <div class="card-header d-flex align-items-center justify-content-between border-bottom">
        <h5 class="card-title m-0 fw-bold">Quản lý Thể loại</h5>
        <button class="btn btn-info text-white" @onclick="OpenCreateForm">
            <i class="bx bx-plus me-1"></i> Thêm thể loại
        </button>
    </div>
    
    <div class="card-body p-0">
        @if (isLoading)
        {
            <div class="p-5 text-center"><div class="spinner-border text-info"></div></div>
        }
        else if (categories == null || !categories.Any())
        {
            <div class="p-5 text-center text-muted">Chưa có dữ liệu thể loại.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center" style="width: 60px;">ID</th>
                            <th>Tên thể loại</th>
                            <th>Đường dẫn (Slug)</th>
                            <th class="text-center" style="width: 120px;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in categories)
                        {
                            <tr>
                                <td class="text-center text-muted fw-bold">@cat.Id</td>
                                <td class="fw-bold text-dark">
                                    <i class="bx bx-hash text-info me-1"></i> @cat.Name
                                </td>
                                <td><span class="badge bg-label-secondary">@cat.Slug</span></td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-icon btn-outline-info me-1" @onclick="() => OpenEditForm(cat.Id)">
                                        <i class="bx bx-edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-icon btn-outline-danger" @onclick="() => DeleteCategory(cat.Id, cat.Name)">
                                        <i class="bx bx-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (isFormOpen)
{
    <CategoryForm CategoryId="selectedCategoryId" OnClose="CloseForm" OnSaved="ReloadData" />
}

@code {
    private List<CategoryDto>? categories;
    private bool isLoading = true;
    private bool isFormOpen = false;
    private int? selectedCategoryId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        isLoading = true;
        categories = await Http.GetFromJsonAsync<List<CategoryDto>>("api/categories");
        isLoading = false;
    }

    private void OpenCreateForm() { selectedCategoryId = null; isFormOpen = true; }
    private void OpenEditForm(int id) { selectedCategoryId = id; isFormOpen = true; }
    private void CloseForm() { isFormOpen = false; }
    private async Task ReloadData() { isFormOpen = false; await LoadData(); }

    private async Task DeleteCategory(int id, string name)
    {
        if (await JSR.InvokeAsync<bool>("confirm", $"Bạn có chắc chắn muốn xóa thể loại '{name}'?"))
        {
            var res = await Http.DeleteAsync($"api/categories/{id}");
            if (res.IsSuccessStatusCode) await LoadData();
            else await JSR.InvokeVoidAsync("alert", "Có lỗi xảy ra khi xóa.");
        }
    }
}