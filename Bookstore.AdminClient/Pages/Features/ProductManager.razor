@page "/manager-books"

<div class="container-fluid px-4 pb-5" id="product-list-section">
    <div class="row g-4">
        @* --- SIDEBAR BỘ LỌC --- *@
        <aside class="col-lg-3 col-xl-3">
            <div class="card border-0 shadow-sm sticky-top" style="top: 85px; border-radius: 12px;">
                <div class="card-body p-4">

                    <div class="mb-4">
                        <h6 class="fw-bold mb-3 text-uppercase small text-muted"><i class="bx bx-book me-2"></i>Sách</h6>
                        <div class="input-group input-group-merge border rounded-pill overflow-hidden">
                            <span class="input-group-text border-0 bg-white"><i class="bx bx-search"></i></span>
                            <input type="text" class="form-control border-0 shadow-none ps-0"
                                   placeholder="Tên sách..."
                                   @bind="Filter.SearchText"
                                   @bind:event="oninput"
                                   @onkeyup="ApplyFilters" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <h6 class="fw-bold mb-3 text-uppercase small text-muted"><i class="bx bx-pen me-2"></i>Tác giả</h6>
                        <div class="input-group input-group-merge border rounded-pill overflow-hidden">
                            <span class="input-group-text border-0 bg-white"><i class="bx bx-user"></i></span>
                            <input type="text" class="form-control border-0 shadow-none ps-0"
                                   placeholder="Tên tác giả..."
                                   @bind="Filter.AuthorName"
                                   @bind:event="oninput"
                                   @onkeyup="ApplyFilters" />
                        </div>
                    </div>

                    <hr class="text-muted opacity-25" />

                    <div class="mb-4">
                        <h6 class="fw-bold mb-3 text-uppercase small text-muted"><i class="bx bx-wallet me-2"></i>Giá (VNĐ)</h6>
                        <div class="d-flex flex-column gap-2 ms-1">
                            <label class="form-check-label custom-option custom-option-basic rounded">
                                <input class="form-check-input me-2" type="radio" name="priceRange"
                                       checked="@(Filter.MinPrice == null && Filter.MaxPrice == null)"
                                       @onclick="() => SetPriceRange(null, null)">
                                <span>Tất cả giá</span>
                            </label>
                            <label class="form-check-label custom-option custom-option-basic">
                                <input class="form-check-input me-2" type="radio" name="priceRange"
                                       checked="@(Filter.MinPrice == 100000 && Filter.MaxPrice == 300000)"
                                       @onclick="() => SetPriceRange(100000, 300000)">
                                <span>100k - 300k</span>
                            </label>
                            <label class="form-check-label custom-option custom-option-basic">
                                <input class="form-check-input me-2" type="radio" name="priceRange"
                                       checked="@(Filter.MinPrice == 300000 && Filter.MaxPrice == 500000)"
                                       @onclick="() => SetPriceRange(300000, 500000)">
                                <span>300k - 500k</span>
                            </label>
                            <label class="form-check-label custom-option custom-option-basic">
                                <input class="form-check-input me-2" type="radio" name="priceRange"
                                       checked="@(Filter.MinPrice == 500000)"
                                       @onclick="() => SetPriceRange(500000, null)">
                                <span>Trên 500k</span>
                            </label>
                        </div>

                        <div class="mt-4 px-1">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="small text-muted">Dưới:</span>
                                <span class="fw-bold text-primary">@((Filter.MaxPrice ?? 2000000).ToString("N0"))</span>
                            </div>
                            <input type="range" class="form-range" min="0" max="2000000" step="50000"
                                   value="@(Filter.MaxPrice ?? 2000000)"
                                   @onchange="OnMaxPriceSliderChanged">
                        </div>
                    </div>
                </div>
            </div>
        </aside>

        @* --- DANH SÁCH SẢN PHẨM --- *@
        <main class="col-lg-9 col-xl-9">
            <div class="d-lg-none mb-4">
                <div class="category-scroll">
                    <div class="cat-pill @(string.IsNullOrEmpty(Filter.Tag) ? "active" : "")"
                         @onclick='() => { Filter.Tag = null; ApplyFilters(); }'>
                        Tất cả
                    </div>
                    <div class="cat-pill @(Filter.Tag == "Tiểu thuyết" ? "active" : "")"
                         @onclick='() => { Filter.Tag = "Tiểu thuyết"; ApplyFilters(); }'>
                        Tiểu thuyết
                    </div>
                    <div class="cat-pill @(Filter.Tag == "Kinh tế" ? "active" : "")"
                         @onclick='() => { Filter.Tag = "Kinh tế"; ApplyFilters(); }'>
                        Kinh tế
                    </div>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="d-flex justify-content-center py-5">
                    <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
                </div>
            }
            else if (PagedBooks.Count == 0)
            {
                <div class="text-center py-5">
                    <img src="/assets/img/illustrations/girl-doing-yoga-light.png" alt="Empty" style="width: 200px; opacity: 0.8;" class="mb-3">
                    <h5 class="fw-bold text-secondary">Không tìm thấy sách nào!</h5>
                    <p class="text-muted">Thử thay đổi từ khóa hoặc bộ lọc giá xem sao nhé.</p>
                    <button class="btn btn-primary rounded-pill shadow-sm" @onclick="ResetFilters">Xóa bộ lọc</button>
                </div>
            }
            else
            {
                @* --- THANH CÔNG CỤ: BADGE LỌC & NÚT CHUYỂN ĐỔI VIEW --- *@
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        @if (!string.IsNullOrEmpty(Filter.SearchText) || Filter.MinPrice.HasValue || Filter.MaxPrice.HasValue || !string.IsNullOrEmpty(Filter.AuthorName))
                        {
                            <span class="badge bg-label-primary rounded-pill">Đang lọc kết quả</span>
                        }
                    </div>

                    @* Nút chuyển đổi chế độ xem *@
                    <div class="btn-group shadow-sm" role="group">
                        <button type="button" class="btn @(isGridView ? "btn-primary" : "btn-outline-primary")" @onclick="() => isGridView = true" title="Dạng lưới">
                            <i class="bx bx-grid-alt"></i>
                        </button>
                        <button type="button" class="btn @(!isGridView ? "btn-primary" : "btn-outline-primary")" @onclick="() => isGridView = false" title="Dạng danh sách">
                            <i class="bx bx-list-ul"></i>
                        </button>
                    </div>
                </div>

                @* --- HIỂN THỊ DỮ LIỆU --- *@
                @if (isGridView)
                {
                    @* CHẾ ĐỘ DẠNG LƯỚI (GRID VIEW) - Gọi BookCard Component *@
                    <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3 g-lg-4">
                        @foreach (var book in PagedBooks)
                        {
                            <div class="col">
                                <BookCard Book="book" />
                            </div>
                        }
                    </div>
                }
                else
                {
                    @* CHẾ ĐỘ DẠNG DANH SÁCH (LIST VIEW) - Vẽ Bảng *@
                    <div class="table-responsive bg-white rounded-3 shadow-sm border">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-center" style="width: 60px;">STT</th>
                                    <th style="width: 80px;">Hình ảnh</th>
                                    <th>Tên sách</th>
                                    <th>Giá</th>
                                    <th class="text-center">Tồn kho</th>
                                    <th>Cập nhật gần nhất</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int stt = (CurrentPage - 1) * PageSize + 1;
                                }
                                @foreach (var book in PagedBooks)
                                {
                                    <tr>
                                        <td class="text-center text-muted fw-bold">@(stt++)</td>
                                        <td>
                                            <img src="@(string.IsNullOrEmpty(book.ImageUrl) ? "/assets/img/default-book.png" : book.ImageUrl)"
                                                 class="rounded object-fit-cover border" width="60" height="60" alt="@book.Title"
                                                 style="cursor: pointer;" @onclick='() => Navigation.NavigateTo($"/product/{book.Id}")' />
                                        </td>
                                        <td>
                                            <a href="/product/@book.Id" class="fw-bold text-dark text-decoration-none d-block text-truncate" style="max-width: 250px;" title="@book.Title">
                                                @book.Title
                                            </a>
                                            <small class="text-muted"><i class="bx bx-pen me-1"></i>@(book.AuthorName ?? "Đang cập nhật")</small>
                                        </td>
                                        <td>
                                            @if (book.Promotion != null)
                                            {
                                                var discountedPrice = book.Price;
                                                if (book.Promotion.DiscountType == 1)
                                                {
                                                    discountedPrice = book.Price - (book.Price * book.Promotion.DiscountValue / 100);
                                                }
                                                else
                                                {
                                                    discountedPrice = book.Price - book.Promotion.DiscountValue;
                                                }
                                                <div class="text-primary fw-bold mb-1">@discountedPrice.ToString("N0")đ</div>
                                                <div class="text-muted text-decoration-line-through small" style="font-size: 0.8rem;">@book.Price.ToString("N0")đ</div>
                                            }
                                            else
                                            {
                                                <div class="text-primary fw-bold">@book.Price.ToString("N0")đ</div>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (book.Stock > 0)
                                            {
                                                <span class="badge bg-label-success">@book.Stock</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-label-danger">Hết hàng</span>
                                            }
                                        </td>
                                        <td>
                                            @if (book.UpdatedAt.HasValue)
                                            {
                                                <div class="d-flex flex-column small">
                                                    <span class="text-dark mb-1"><i class="bx bx-time-five me-1"></i>@book.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                                    <span class="text-muted"><i class="bx bx-user me-1"></i>@(book.UpdatedBy ?? "Hệ thống")</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small fst-italic">Chưa cập nhật</span>
                                            }
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => EditBook(book.Id)">
                                                <i class="bx bx-edit"></i> Sửa
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </main>
    </div>
</div>


@if(isActiveForm)
{
    <BookForm BookId="bookId" OnSaved="() => { isActiveForm = false; }" OnClose="() => isActiveForm = false" />
}

@* --- PHÂN TRANG THEO CHIỀU DỌC (GIỮ NGUYÊN CSS CỦA BẠN) --- *@
@if (TotalPages > 1)
{
    <div class="pagination-fixed">
        <nav aria-label="Page navigation">
            <ul class="pagination pagination-vertical">
                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(CurrentPage - 1)">
                        <i class="bx bx-chevron-up"></i>
                    </button>
                </li>

                @for (int i = 1; i <= TotalPages; i++)
                {
                    var pageNumber = i;
                    int delta = 2;
                    if (i == 1 || (i >= CurrentPage - delta && i <= CurrentPage + delta) || i == TotalPages)
                    {
                        <li class="page-item @(CurrentPage == pageNumber ? "active" : "")">
                            <button class="page-link" @onclick="() => ChangePage(pageNumber)">@pageNumber</button>
                        </li>
                    }
                    else if ((i == CurrentPage - delta - 1 && i > 1) || (i == CurrentPage + delta + 1 && i < TotalPages))
                    {
                        <li class="page-item disabled"><span class="page-link border-0 bg-transparent text-muted small">...</span></li>
                    }
                }

                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(CurrentPage + 1)">
                        <i class="bx bx-chevron-down"></i>
                    </button>
                </li>
            </ul>
        </nav>
    </div>
}


@code {
    private bool isLoading = true;
    private bool isGridView = true;
    private bool isActiveForm = false;

    private int? bookId = null;
    // Nguồn dữ liệu tổng gốc từ API
    private List<BookAdminDto> AllBooks = new();
    // Dữ liệu sau khi áp dụng các điều kiện lọc (Filter)
    private List<BookAdminDto> FilteredBooks = new();
    // Dữ liệu sách hiển thị trên 1 trang cụ thể
    private List<BookAdminDto> PagedBooks = new();

    // Bộ lọc theo DTO
    private BookFilterRequestDto Filter = new();

    // Thuộc tính phân trang
    private int CurrentPage = 1;
    private int PageSize = 12; // Số lượng sách trên mỗi trang
    private int TotalPages => (int)Math.Ceiling((double)FilteredBooks.Count / PageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            AllBooks = await Http.GetFromJsonAsync<List<BookAdminDto>>("api/books/admin");
            ApplyFilters();
        }
        finally
        {
            isLoading = false;
        }
    }

    // Hàm xử lý lọc dữ liệu ngay trên RAM (Client-side)
    private void ApplyFilters()
    {
        var query = AllBooks.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(Filter.SearchText))
            query = query.Where(b => b.Title.Contains(Filter.SearchText, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(Filter.AuthorName))
            query = query.Where(b => b.AuthorName != null && b.AuthorName.Contains(Filter.AuthorName, StringComparison.OrdinalIgnoreCase));

        if (Filter.MinPrice.HasValue)
            query = query.Where(b => b.Price >= Filter.MinPrice.Value);

        if (Filter.MaxPrice.HasValue)
            query = query.Where(b => b.Price <= Filter.MaxPrice.Value);

        // Lọc theo Tag (Giả sử Tag là thể loại/nhãn)
        // if (!string.IsNullOrWhiteSpace(Filter.Tag)) ...

        FilteredBooks = query.ToList();

        // Reset về trang 1 sau mỗi lần lọc dữ liệu
        CurrentPage = 1;
        UpdatePagedData();
    }

    // Hàm xử lý cắt danh sách hiển thị đúng số lượng PageSize
    private void UpdatePagedData()
    {
        PagedBooks = FilteredBooks
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();
    }

    private void ChangePage(int newPage)
    {
        if (newPage >= 1 && newPage <= TotalPages)
        {
            CurrentPage = newPage;
            UpdatePagedData();
        }
    }

    private void SetPriceRange(decimal? min, decimal? max)
    {
        Filter.MinPrice = min;
        Filter.MaxPrice = max;
        ApplyFilters();
    }

    private void OnMaxPriceSliderChanged(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out decimal value))
        {
            Filter.MaxPrice = value;
            ApplyFilters();
        }
    }

    private void ResetFilters()
    {
        Filter = new BookFilterRequestDto();
        ApplyFilters();
    }

    private void CreateNewBook()
    {
        bookId = null; // Đặt bằng null để BookForm hiểu là tạo mới
        isActiveForm = true;
    }

    // Hàm gọi khi muốn SỬA
    private void EditBook(int id)
    {
        bookId = id; // Truyền ID sách vào
        isActiveForm = true;
    }

    // Hàm gọi khi form đã lưu thành công
    private async Task HandleBookSaved()
    {
        isActiveForm = false; // Đóng form
        await LoadData();     // GỌI LẠI HÀM LOAD DATA ĐỂ LÀM MỚI BẢNG SÁCH
    }
}