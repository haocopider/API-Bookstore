<div class="card mb-4 shadow-sm border-0">
    <div class="card-header d-flex align-items-center justify-content-between border-bottom">
        <h5 class="card-title m-0 fw-bold">Quản lý Nhân sự</h5>
        <button class="btn btn-danger fw-bold shadow-sm" @onclick="OpenCreateForm">
            <i class="bx bx-user-plus me-1"></i> Thêm nhân viên
        </button>
    </div>
    
    <div class="card-body p-0">
        @if (isLoading)
        {
            <div class="p-5 text-center"><div class="spinner-border text-danger"></div></div>
        }
        else if (staffList == null || !staffList.Any())
        {
            <div class="p-5 text-center text-muted">Chưa có dữ liệu nhân viên.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center">ID</th>
                            <th>Tài khoản</th>
                            <th>Email</th>
                            <th>Vai trò (Role)</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var staff in staffList)
                        {
                            <tr>
                                <td class="text-center text-muted fw-bold">@staff.Id</td>
                                <td class="fw-bold text-dark">
                                    <i class="bx bx-user-circle text-muted fs-4 align-middle me-1"></i>
                                    @staff.Username
                                </td>
                                <td>@(string.IsNullOrEmpty(staff.Email) ? "---" : staff.Email)</td>
                                <td>
                                    <span class="badge bg-label-primary">@staff.RoleName</span>
                                </td>
                                <td class="text-center">
                                    @if (staff.IsActive)
                                    {
                                        <span class="badge bg-success shadow-sm"><i class="bx bx-check-circle me-1"></i> Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary shadow-sm"><i class="bx bx-lock-alt me-1"></i> Đã khóa</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-icon btn-outline-primary me-1" @onclick="() => OpenEditForm(staff.Id)" title="Chỉnh sửa">
                                        <i class="bx bx-edit"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (isFormOpen)
{
    <StaffForm StaffId="selectedStaffId" OnClose="CloseForm" OnSaved="ReloadData" />
}

@code {
    private List<AdminDto>? staffList;
    private bool isLoading = true;
    private bool isFormOpen = false;
    private int? selectedStaffId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        isLoading = true;
        // Gọi API Controller AdminManagementController mà chúng ta đã xây dựng
        staffList = await Http.GetFromJsonAsync<List<AdminDto>>("api/admins/staff");
        isLoading = false;
    }

    private void OpenCreateForm() { selectedStaffId = null; isFormOpen = true; }
    private void OpenEditForm(int id) { selectedStaffId = id; isFormOpen = true; }
    private void CloseForm() { isFormOpen = false; }
    private async Task ReloadData() { isFormOpen = false; await LoadData(); }
}