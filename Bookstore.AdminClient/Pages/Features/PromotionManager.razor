
<div class="card mb-4 shadow-sm border-0">
    <div class="card-header d-flex align-items-center justify-content-between border-bottom">
        <h5 class="card-title m-0 fw-bold">Quản lý Khuyến mãi</h5>
        <button class="btn btn-warning text-dark fw-bold" @onclick="OpenCreateForm">
            <i class="bx bx-plus me-1"></i> Thêm khuyến mãi
        </button>
    </div>
    
    <div class="card-body p-0">
        @if (isLoading)
        {
            <div class="p-5 text-center"><div class="spinner-border text-warning"></div></div>
        }
        else if (promotions == null || !promotions.Any())
        {
            <div class="p-5 text-center text-muted">Chưa có dữ liệu khuyến mãi.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center">ID</th>
                            <th>Tên chương trình</th>
                            <th>Mức giảm</th>
                            <th>Hạn sử dụng</th>
                            <th class="text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var promo in promotions)
                        {
                            <tr>
                                <td class="text-center text-muted fw-bold">@promo.Id</td>
                                <td class="fw-bold text-dark">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar avatar-sm me-2 bg-light rounded">
                                            <i class="bx bx-gift text-warning fs-4"></i>
                                        </div>
                                        @promo.Name
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-label-danger">
                                        -@promo.DiscountValue @(promo.DiscountType == 1 ? "%" : "đ")
                                    </span>
                                </td>
                                <td>
                                    @if (promo.EndDate < DateTime.UtcNow)
                                    {
                                        <span class="text-danger small"><i class="bx bx-time"></i> Đã hết hạn</span>
                                    }
                                    else
                                    {
                                        <span class="text-success small"><i class="bx bx-time"></i> @promo.EndDate.ToString("dd/MM/yyyy")</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-icon btn-outline-warning me-1" @onclick="() => OpenEditForm(promo.Id)">
                                        <i class="bx bx-edit text-dark"></i>
                                    </button>
                                    <button class="btn btn-sm btn-icon btn-outline-danger" @onclick="() => DeletePromotion(promo.Id, promo.Name)">
                                        <i class="bx bx-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (isFormOpen)
{
    <PromotionForm PromotionId="selectedPromoId" OnClose="CloseForm" OnSaved="ReloadData" />
}

@code {
    private List<PromotionInfoDTO>? promotions;
    private bool isLoading = true;
    private bool isFormOpen = false;
    private int? selectedPromoId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        isLoading = true;
        // Giả sử bạn có endpoint GET api/promotions
        promotions = await Http.GetFromJsonAsync<List<PromotionInfoDTO>>("api/promotions");
        isLoading = false;
    }

    private void OpenCreateForm() { selectedPromoId = null; isFormOpen = true; }
    private void OpenEditForm(int id) { selectedPromoId = id; isFormOpen = true; }
    private void CloseForm() { isFormOpen = false; }
    private async Task ReloadData() { isFormOpen = false; await LoadData(); }

    private async Task DeletePromotion(int id, string name)
    {
        if (await JSR.InvokeAsync<bool>("confirm", $"Bạn có chắc chắn muốn xóa/vô hiệu hóa KM '{name}'?"))
        {
            var res = await Http.DeleteAsync($"api/promotions/{id}");
            if (res.IsSuccessStatusCode) await LoadData();
            else await JSR.InvokeVoidAsync("alert", "Có lỗi xảy ra.");
        }
    }
}