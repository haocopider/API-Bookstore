<div class="modal-backdrop fade show"></div>
<div class="modal fade show d-block" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom">
                <h5 class="modal-title mb-0 fw-semibold">
                    @(AuthorId == null ? "✨ Thêm tác giả mới" : "✏️ Cập nhật tác giả")
                </h5>
                <button type="button" class="btn-close" aria-label="Close" @onclick="OnClose"></button>
            </div>

            <div class="modal-body bg-light">
                @if (isLoading)
                {
                    <div class="d-flex flex-column align-items-center justify-content-center py-4">
                        <div class="spinner-border text-primary mb-3"></div>
                        <div class="text-muted">Đang tải dữ liệu...</div>
                    </div>
                }
                else
                {
                    <EditForm Model="authorModel" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <div class="mb-3">
                                    <label class="form-label">Tên tác giả <span class="text-danger">*</span></label>
                                    <InputText class="form-control" @bind-Value="authorModel.Name" placeholder="Nhập tên tác giả..." />
                                    <ValidationMessage For="@(() => authorModel.Name)" class="text-danger small" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">URL Ảnh đại diện</label>
                                    <InputText class="form-control" @bind-Value="authorModel.AvatarUrl" placeholder="https://..." />
                                </div>
                                <div class="mb-4">
                                    <label class="form-label">Tiểu sử</label>
                                    <InputTextArea class="form-control" @bind-Value="authorModel.Bio" rows="4" placeholder="Giới thiệu về tác giả..." />
                                </div>
                                <div class="text-end border-top pt-3">
                                    <button type="button" class="btn btn-secondary me-2" @onclick="OnClose">Hủy</button>
                                    <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                                        @if (isSubmitting)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        <i class="bx bx-save me-1"></i> Lưu lại
                                    </button>
                                </div>
                            </div>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int? AuthorId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private CreateAuthorDto authorModel = new();
    private bool isLoading = false;
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        if (AuthorId.HasValue)
        {
            isLoading = true;
            var existing = await Http.GetFromJsonAsync<AuthorDto>($"api/authors/{AuthorId.Value}");
            if (existing != null)
            {
                authorModel = new CreateAuthorDto
                {
                    Name = existing.Name,
                    Bio = existing.Bio,
                    AvatarUrl = existing.AvatarUrl
                };
            }
            isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        HttpResponseMessage res;

        if (AuthorId.HasValue)
            res = await Http.PutAsJsonAsync($"api/authors/{AuthorId.Value}", authorModel);
        else
            res = await Http.PostAsJsonAsync("api/authors", authorModel);

        isSubmitting = false;

        if (res.IsSuccessStatusCode)
            await OnSaved.InvokeAsync();
        else
            await JSR.InvokeVoidAsync("alert", "Có lỗi xảy ra khi lưu dữ liệu!");
    }
}