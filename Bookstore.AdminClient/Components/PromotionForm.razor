@using System.ComponentModel.DataAnnotations
<div class="modal-backdrop fade show"></div>
<div class="modal fade show d-block" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom">
                <h5 class="modal-title mb-0 fw-semibold">
                    @(PromotionId == null ? "✨ Tạo Khuyến mãi mới" : "✏️ Cập nhật Khuyến mãi")
                </h5>
                <button type="button" class="btn-close" @onclick="OnClose"></button>
            </div>

            <div class="modal-body bg-light">
                @if (isLoading)
                {
                    <div class="d-flex justify-content-center py-4"><div class="spinner-border text-warning"></div></div>
                }
                else
                {
                    <EditForm Model="promoModel" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        <div class="card border-0 shadow-sm">
                            <div class="card-body row g-3">
                                <div class="col-12 mb-2">
                                    <label class="form-label">Tên chương trình <span class="text-danger">*</span></label>
                                    <InputText class="form-control" @bind-Value="promoModel.Name" placeholder="VD: Siêu Sale Giáng Sinh..." />
                                    <ValidationMessage For="@(() => promoModel.Name)" class="text-danger small" />
                                </div>

                                <div class="col-12 mb-2">
                                    <label class="form-label">Hình ảnh / Banner (URL)</label>
                                    <InputText class="form-control" @bind-Value="promoModel.Banner" @bind-Value:event="oninput" placeholder="https://..." />

                                    @if (!string.IsNullOrWhiteSpace(promoModel.Banner))
                                    {
                                        <div class="mt-3 text-center bg-white border rounded p-2">
                                            <img src="@promoModel.Banner" alt="Banner Preview" class="img-fluid rounded shadow-sm" style="max-height: 150px; object-fit: contain;" onerror="this.onerror=null; this.src='/assets/img/placeholder.png'; this.alt='URL hình ảnh không hợp lệ';" />
                                        </div>
                                    }
                                </div>

                                <div class="col-md-6 mb-2">
                                    <label class="form-label">Loại giảm giá</label>
                                    <InputSelect class="form-select" @bind-Value="promoModel.DiscountType">
                                        <option value="1">Giảm theo Phần trăm (%)</option>
                                        <option value="2">Giảm số tiền trực tiếp (VNĐ)</option>
                                    </InputSelect>
                                </div>

                                <div class="col-md-6 mb-2">
                                    <label class="form-label">Mức giảm <span class="text-danger">*</span></label>
                                    <InputNumber class="form-control" @bind-Value="promoModel.DiscountValue" />
                                    <ValidationMessage For="@(() => promoModel.DiscountValue)" class="text-danger small" />
                                </div>

                                <div class="col-md-6 mb-2">
                                    <label class="form-label">Từ ngày</label>
                                    <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="promoModel.StartDate" />
                                </div>

                                <div class="col-md-6 mb-2">
                                    <label class="form-label">Đến ngày</label>
                                    <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="promoModel.EndDate" />
                                </div>

                                <div class="col-md-6 mb-2">
                                    <label class="form-label">Thể loại áp dụng (Chọn nhiều)</label>
                                    <select class="form-select" multiple @bind="promoModel.CategoryIds" style="height: 120px;">
                                        @if (availableCategories != null)
                                        {
                                            @foreach (var cat in availableCategories)
                                            {
                                                <option value="@cat.Id">@cat.Name</option>
                                            }
                                        }
                                    </select>
                                    <small class="text-muted">Giữ Ctrl (hoặc Cmd) để chọn nhiều</small>
                                </div>

                                <div class="col-md-6 mb-2">
                                    <label class="form-label">Sách áp dụng (Chọn nhiều)</label>
                                    <select class="form-select" multiple @bind="promoModel.BookIds" style="height: 120px;">
                                        @if (availableBooks != null)
                                        {
                                            @foreach (var book in availableBooks)
                                            {
                                                <option value="@book.Id">@book.Title</option>
                                            }
                                        }
                                    </select>
                                    <small class="text-muted">Giữ Ctrl (hoặc Cmd) để chọn nhiều</small>
                                </div>

                                <div class="col-12 mb-2">
                                    <div class="form-check form-switch mt-2">
                                        <InputCheckbox class="form-check-input" @bind-Value="promoModel.IsActive" id="isActive" />
                                        <label class="form-check-label" for="isActive">Kích hoạt chương trình này</label>
                                    </div>
                                </div>

                                <div class="text-end border-top pt-3 mt-3">
                                    <button type="button" class="btn btn-secondary me-2" @onclick="OnClose">Hủy</button>
                                    <button type="submit" class="btn btn-warning text-dark fw-bold" disabled="@isSubmitting">
                                        @if (isSubmitting)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        <i class="bx bx-save me-1"></i> Lưu lại
                                    </button>
                                </div>
                            </div>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int? PromotionId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private PromoViewModel promoModel = new();
    private bool isLoading = true;
    private bool isSubmitting = false;

    private List<CategoryLookupDto> availableCategories = new();
    private List<BookLookupDto> availableBooks = new();

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        try
        {
            availableCategories = await Http.GetFromJsonAsync<List<CategoryLookupDto>>("api/categories") ?? new();
            availableBooks = await Http.GetFromJsonAsync<List<BookLookupDto>>("api/books") ?? new();

            if (PromotionId.HasValue)
            {
                var existing = await Http.GetFromJsonAsync<PromotionInfoDTO>($"api/promotions/{PromotionId.Value}");
                if (existing != null)
                {
                    promoModel.Name = existing.Name;
                    promoModel.Banner = existing.ImageUrl;
                    promoModel.DiscountType = existing.DiscountType;
                    promoModel.DiscountValue = existing.DiscountValue;
                    promoModel.EndDate = existing.EndDate;
                    promoModel.StartDate = DateTime.Now;
                    promoModel.IsActive = true;

                    promoModel.BookIds = existing.BookIds.ToArray();
                    promoModel.CategoryIds = existing.CategoryIds.ToArray();
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService.Error("Lỗi tải dữ liệu: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        HttpResponseMessage res;

        if (PromotionId.HasValue)
        {
            var updateReq = new UpdatePromotionRequest
            {
                Name = promoModel.Name,
                DiscountType = promoModel.DiscountType,
                DiscountValue = promoModel.DiscountValue,
                StartDate = promoModel.StartDate,
                EndDate = promoModel.EndDate,
                IsActive = promoModel.IsActive,
                Banner = promoModel.Banner,
                BookIds = promoModel.BookIds.ToList(),
                CategoryIds = promoModel.CategoryIds.ToList()
            };
            res = await Http.PutAsJsonAsync($"api/promotions/{PromotionId.Value}", updateReq);
        }
        else
        {
            var createReq = new CreatePromotionRequest
            {
                Name = promoModel.Name,
                DiscountType = promoModel.DiscountType,
                DiscountValue = promoModel.DiscountValue,
                StartDate = promoModel.StartDate,
                EndDate = promoModel.EndDate,
                IsActive = promoModel.IsActive,
                BookIds = promoModel.BookIds.ToList(),
                CategoryIds = promoModel.CategoryIds.ToList()
            };
            res = await Http.PostAsJsonAsync("api/promotions", createReq);
        }

        isSubmitting = false;

        if (res.IsSuccessStatusCode)
        {
            NotificationService.Success("Lưu chương trình khuyến mãi thành công!");
            await OnSaved.InvokeAsync();
        }
        else
        {
            var err = await res.Content.ReadFromJsonAsync<ApiResponse>();
            NotificationService.Error(err?.Message ?? "Đã xảy ra lỗi.");
        }
    }


    public class PromoViewModel
    {
        [Required(ErrorMessage = "Vui lòng nhập tên chương trình")]
        public string Name { get; set; } = string.Empty;

        public int DiscountType { get; set; } = 1;

        [Required(ErrorMessage = "Vui lòng nhập mức giảm")]
        public decimal DiscountValue { get; set; }

        public DateTime StartDate { get; set; } = DateTime.Now;
        public DateTime EndDate { get; set; } = DateTime.Now.AddDays(7);
        public bool IsActive { get; set; } = true;
        public string? Banner { get; set; }

        public int[] BookIds { get; set; } = Array.Empty<int>();
        public int[] CategoryIds { get; set; } = Array.Empty<int>();
    }

    public class CategoryLookupDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    public class BookLookupDto
    { 
        public int Id { get; set; }
        public string Title { get; set; } = string.Empty;
    }
}