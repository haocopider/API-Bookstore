@if (IsVisible)
{
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1055;">
        <div class="toast show align-items-center text-white @GetBgColor() border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="@GetIcon() me-2"></i> @Message
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" @onclick="Close"></button>
            </div>
        </div>
    </div>
}

@code {
    private bool IsVisible { get; set; } = false;
    private string Message { get; set; } = "";
    private string Type { get; set; } = "success"; // success, error

    public async Task Show(string message, string type = "success")
    {
        Message = message;
        Type = type;
        IsVisible = true;
        StateHasChanged(); // Cập nhật UI để hiện thông báo ngay

        // Đợi 3 giây rồi tự tắt
        await Task.Delay(3000);

        // Kiểm tra lại (đề phòng trường hợp người dùng tắt thủ công trước đó)
        if (IsVisible)
        {
            await Close();
        }
    }

    private async Task Close()
    {
        IsVisible = false;
        await InvokeAsync(StateHasChanged);
    }

    private string GetBgColor() => Type switch
    {
        "success" => "bg-success",
        "error" => "bg-danger",
        "warning" => "bg-warning",
        _ => "bg-primary"
    };

    private string GetIcon() => Type switch
    {
        "success" => "bx bx-check-circle",
        "error" => "bx bx-x-circle",
        "warning" => "bx bx-error",
        _ => "bx bx-info-circle"
    };
}