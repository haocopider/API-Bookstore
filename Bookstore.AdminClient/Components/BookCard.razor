<div class="card product-card h-100 position-relative overflow-hidden bg-white">
    @* --- BADGE TRẠNG THÁI KHUYẾN MÃI --- *@
    @if (Book.Promotion != null)
    {
        <span class="badge bg-danger badge-float rounded-pill shadow-sm position-absolute top-0 end-0 m-2 z-3">
            -@Book.Promotion.DiscountValue
        </span>
    }

    @* --- HÌNH ẢNH SẢN PHẨM --- *@
    <div class="ratio ratio-1x1 bg-light position-relative">
        <img src="@(string.IsNullOrEmpty(Book.ImageUrl) ? "/assets/img/default-book.png" : Book.ImageUrl)"
             class="card-img-top object-fit-cover"
             alt="@Book.Title"
             style="cursor: pointer;"
             />

        @* Thông tin Tác giả (Overlay bên dưới ảnh) *@
        <div class="position-absolute bottom-0 start-0 w-100 p-2 bg-gradient-to-t"
             style="background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);">
            <div class="d-flex align-items-center text-white" style="cursor: pointer;">
                <i class="bx bx-pen me-1"></i>
                <small class="ms-1 text-truncate fw-medium" style="max-width: 80%;">
                    @(string.IsNullOrEmpty(Book.AuthorName) ? "Đang cập nhật" : Book.AuthorName)
                </small>
            </div>
        </div>
    </div>

    @* --- BODY THẺ SẢN PHẨM --- *@
    <div class="card-body p-3 d-flex flex-column">
        <div class="mb-auto">
            <h6 class="card-title text-truncate-2 mb-1" style="font-size: 0.95rem; min-height: 2.4em; line-height: 1.2em;">
                <a href="/product/@Book.Id" class="text-dark text-decoration-none stretched-link">@Book.Title</a>
            </h6>

            <p class="small text-muted mb-1 text-truncate" title="Nhà xuất bản">
                <i class="bx bx-buildings"></i> @Book.Publisher
            </p>
            <p class="small text-muted text-truncate-2" style="font-size: 0.8rem;">
                @Book.Description
            </p>
        </div>

        <div class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top">
            <div class="fw-bold text-primary" style="font-size: 1.1rem;">
                @if (Book.Promotion != null)
                {
                    // Tính giá sau khuyến mãi
                    var discountedPrice = Book.Price - Book.Promotion.DiscountValue;
                    <span>@discountedPrice.ToString("N0")<span class="small align-top text-decoration-underline">đ</span></span>
                    <br />
                    <small class="text-muted text-decoration-line-through fw-normal" style="font-size: 0.85rem;">@Book.Price.ToString("N0")đ</small>
                }
                else
                {
                    <span>@Book.Price.ToString("N0")<span class="small align-top text-decoration-underline">đ</span></span>
                }
            </div>
        </div>
        @if (OnEdit.HasDelegate)
        {
            <div class="mt-3 pt-2 border-top">
                <button class="btn btn-sm btn-outline-primary w-100 fw-bold"
                        @onclick="() => OnEdit.InvokeAsync(Book.Id)"
                        @onclick:stopPropagation="true">
                    <i class="bx bx-edit me-1"></i> Cập nhật
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public BookAdminDto Book { get; set; } = null!;

    [Parameter]
    public EventCallback<int> OnEdit { get; set; }
}