
<div class="modal-backdrop fade show"></div>

<!-- Modal -->
<div class="modal fade show d-block" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">

            <!-- HEADER -->
            <div class="modal-header border-bottom">
                <div>
                    <h5 class="modal-title mb-0 fw-semibold">
                        @(BookId == null ? "✨ Thêm sản phẩm mới" : $"✏️ Cập nhật sản phẩm")
                    </h5>
                </div>

                <button type="button"
                        class="btn-close"
                        aria-label="Close"
                        @onclick="OnClose">
                </button>
            </div>

            <!-- BODY -->
            <div class="modal-body bg-light">

                @if (isLoading)
                {
                    <div class="d-flex flex-column align-items-center justify-content-center py-5">
                        <div class="spinner-border text-primary mb-3"></div>
                        <div class="text-muted">Đang tải dữ liệu...</div>
                    </div>
                }
                else
                {
                    <EditForm Model="bookModel" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />

                        <div class="row g-4">
                            @* --- CỘT TRÁI: THÔNG TIN CƠ BẢN --- *@
                            <div class="col-lg-7 border-end">
                                <h6 class="fw-bold mb-3 text-muted">THÔNG TIN CƠ BẢN</h6>

                                <div class="mb-3">
                                    <label class="form-label">Tên sách <span class="text-danger">*</span></label>
                                    <InputText class="form-control" @bind-Value="bookModel.Title" placeholder="Nhập tên sách..." />
                                    <ValidationMessage For="@(() => bookModel.Title)" class="text-danger small" />
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Tên Tác giả <span class="text-danger">*</span></label>
                                        <InputText class="form-control" @bind-Value="bookModel.AuthorName" placeholder="Tên tác giả..." />
                                        <ValidationMessage For="@(() => bookModel.AuthorName)" class="text-danger small" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Nhà xuất bản</label>
                                        <InputText class="form-control" @bind-Value="bookModel.Publisher" placeholder="Nhà xuất bản..." />
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">URL Ảnh bìa</label>
                                    <InputText class="form-control" @bind-Value="bookModel.CoverImageUrl" placeholder="https://..." />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Mô tả nội dung</label>
                                    <InputTextArea class="form-control" @bind-Value="bookModel.Description" rows="4" placeholder="Giới thiệu sơ lược về sách..." />
                                </div>
                            </div>

                            @* --- CỘT PHẢI: THỂ LOẠI & ĐỊNH DẠNG SÁCH --- *@
                            <div class="col-lg-5">

                                @* 1. Quản lý Thể loại (Categories) *@
                                <h6 class="fw-bold mb-3 text-muted">THỂ LOẠI</h6>
                                <div class="mb-4">
                                    <div class="input-group mb-2">
                                        <input type="text" class="form-control" placeholder="Thêm thể loại..."
                                               @bind="categoryInput" @onkeyup="HandleCategoryInput" />
                                        <button type="button" class="btn btn-outline-primary" @onclick="AddCategory">
                                            <i class="bx bx-plus"></i> Thêm
                                        </button>
                                    </div>
                                    <ValidationMessage For="@(() => bookModel.CategoryNames)" class="text-danger small d-block mb-2" />

                                    <div class="mb-2">
                                        <InputSelect class="form-select form-select-sm" @bind-Value="categoryInput" @onchange="OnCategorySelectChanged">
                                            <option value="">-- Chọn thể loại --</option>
                                            @foreach (var c in AvailableCategories)
                                            {
                                                <option value="@c.Name">@c.Name</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <div class="d-flex flex-wrap gap-2 mt-2">
                                        @if (bookModel.CategoryNames.Count == 0)
                                        {
                                            <span class="text-muted small fst-italic">Chưa có thể loại nào.</span>
                                        }
                                        @foreach (var cat in bookModel.CategoryNames)
                                        {
                                            <span class="badge bg-label-info d-flex align-items-center p-2">
                                                @cat
                                                <i class="bx bx-x ms-2" style="cursor:pointer;" @onclick="() => RemoveCategory(cat)"></i>
                                            </span>
                                        }
                                    </div>
                                </div>

                                <hr class="text-muted opacity-25 my-4" />

                                @* 2. Quản lý Định dạng & Tồn kho (Formats) *@
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="fw-bold m-0 text-muted">ĐỊNH DẠNG & KHO</h6>
                                    <button type="button" class="btn btn-sm btn-success" @onclick="AddFormat">
                                        <i class="bx bx-plus"></i> Thêm định dạng
                                    </button>
                                </div>
                                <ValidationMessage For="@(() => bookModel.Formats)" class="text-danger small d-block mb-3" />

                                @if (bookModel.Formats.Count == 0)
                                {
                                    <div class="alert alert-warning small py-2">Bạn cần thêm ít nhất 1 định dạng cho sách.</div>
                                }

                                <div class="list-group">
                                    @foreach (var format in bookModel.Formats)
                                    {
                                        <div class="list-group-item bg-light border">
                                            <div class="d-flex justify-content-between mb-2">
                                                <strong>Cấu hình bản in</strong>
                                                <button type="button" class="btn btn-sm btn-link text-danger p-0" @onclick="() => RemoveFormat(format)">
                                                    <i class="bx bx-trash"></i> Xóa
                                                </button>
                                            </div>
                                            <div class="row g-2">
                                                <div class="col-12">
                                                    <label class="form-label small">Định dạng</label>
                                                    <InputSelect class="form-select form-select-sm" @bind-Value="format.Format">
                                                        <option value="0">Sách mới</option>
                                                        <option value="1">Sách cũ</option>
                                                    </InputSelect>
                                                </div>
                                                <div class="col-6">
                                                    <label class="form-label small">Giá bán (VNĐ)</label>
                                                    <InputNumber class="form-control form-control-sm" @bind-Value="format.Price" />
                                                </div>
                                                <div class="col-6">
                                                    <label class="form-label small">Tồn kho</label>
                                                    <InputNumber class="form-control form-control-sm" @bind-Value="format.Stock" />
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>

                            </div>
                        </div>

                        <div class="text-end mt-4 pt-3 border-top">
                            <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="bx bx-save me-1"></i> Lưu Sách
                            </button>
                        </div>
                    </EditForm>

                }
            </div>

    </div>
</div>
</div>




@code {
    [Parameter]
    public int? BookId { get; set; }
    [Parameter]
    public BookAdminDto? SelectedBook { get; set; }

    [Parameter]
    public EventCallback OnSaved { get; set; }
    [Parameter]
    public EventCallback OnClose { get; set; } 

    private CreateBookDto bookModel = new();
    private bool isLoading = false;
    private bool isSubmitting = false;

    private string categoryInput = string.Empty;
    private List<CategoryDto> AvailableCategories = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();

        if (BookId.HasValue)
        {
            await LoadBookData(BookId.Value);
        }
        else
        {
            // Initialize two formats: 0 = new, 1 = used
            if (SelectedBook != null)
            {
                // If parent passed SelectedBook, use it
                bookModel = new CreateBookDto
                {
                    Title = SelectedBook.Title,
                    Description = SelectedBook.Description,
                    Publisher = SelectedBook.Publisher,
                    CoverImageUrl = SelectedBook.ImageUrl,
                    AuthorName = SelectedBook.AuthorName ?? "",
                    CategoryNames = new List<string>(),
                    Formats = SelectedBook.BookFormats.Select(f => new CreateBookFormatDto { Format = f.Type, Price = f.Price, Stock = f.Stock }).ToList()
                };
            }
            else
            {
                bookModel.Formats.Add(new CreateBookFormatDto { Format = 0, Price = 0, Stock = 0 });
                bookModel.Formats.Add(new CreateBookFormatDto { Format = 1, Price = 0, Stock = 0 });
            }
        }
    }

    private async Task LoadCategories()
    {
        try
        {
            var cats = await Http.GetFromJsonAsync<List<CategoryDto>>("api/categories");
            AvailableCategories = cats ?? new List<CategoryDto>();
        }
        catch
        {
            AvailableCategories = new List<CategoryDto>();
        }
    }

    private async Task LoadBookData(int id)
    {
        isLoading = true;
        try
        {
            // Giả lập lấy dữ liệu sách (Bạn sửa lại theo API trả về BookDto của bạn)
            var existingBook = await Http.GetFromJsonAsync<BookAdminDto>($"api/books/admin/{id}");

            if (existingBook != null)
            {
                bookModel = new CreateBookDto
                {
                    Title = existingBook.Title,
                    Description = existingBook.Description,
                    Publisher = existingBook.Publisher,
                    CoverImageUrl = existingBook.ImageUrl,
                    AuthorName = existingBook.AuthorName ?? "",
                    CategoryNames = new List<string>(),
                    Formats = existingBook.BookFormats.Select(f => new CreateBookFormatDto { Format = f.Type, Price = f.Price, Stock = f.Stock }).ToList()
                };
            }
        }
        catch (Exception ex)
        {
            NotificationService.Error("Lỗi tải thông tin sách: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    // --- LOGIC THỂ LOẠI (CATEGORIES) ---
    private void HandleCategoryInput(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddCategory();
        }
    }

    private void AddCategory()
    {
        if (!string.IsNullOrWhiteSpace(categoryInput))
        {
            var formattedCat = categoryInput.Trim();
            if (!bookModel.CategoryNames.Contains(formattedCat))
            {
                bookModel.CategoryNames.Add(formattedCat);
            }
            categoryInput = string.Empty;
        }
    }

    private void OnCategorySelectChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(val))
        {
            categoryInput = val;
            AddCategory();
        }
    }

    private void RemoveCategory(string category)
    {
        bookModel.CategoryNames.Remove(category);
    }

    // --- LOGIC ĐỊNH DẠNG (FORMATS) ---
    private void AddFormat()
    {
        bookModel.Formats.Add(new CreateBookFormatDto { Format = 1, Price = 0, Stock = 0 });
    }

    private void RemoveFormat(CreateBookFormatDto format)
    {
        bookModel.Formats.Remove(format);
    }

    private async Task HandleSubmit()
    {
        if (bookModel.CategoryNames.Count == 0)
        {
            NotificationService.Error("Vui lòng thêm ít nhất 1 thể loại!");
            return;
        }
        if (bookModel.Formats.Count == 0)
        {
            NotificationService.Error("Vui lòng thêm ít nhất 1 định dạng sách!");
            return;
        }

        isSubmitting = true;
        try
        {
            HttpResponseMessage response;

            if (BookId.HasValue)
            {
                response = await Http.PutAsJsonAsync($"api/books/admin/update/{BookId.Value}", bookModel);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/books/admin/create", bookModel);
            }

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Success(BookId.HasValue ? "Cập nhật sách thành công!" : "Tạo sách thành công!");
                await OnSaved.InvokeAsync();
            }
            else
            {
                var err = await response.Content.ReadFromJsonAsync<ApiResponse>();
                NotificationService.Error(err?.Message ?? "Đã xảy ra lỗi.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Error("Có lỗi xảy ra: " + ex.Message);
        }
        finally
        {
            isSubmitting = false;
        }
    }
}