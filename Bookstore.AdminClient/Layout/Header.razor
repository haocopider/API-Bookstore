@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject NavigationManager Navigation

<nav class="layout-navbar container-xxl navbar navbar-expand-xl navbar-detached align-items-center bg-navbar-theme"
     style="position: sticky; top: 0; z-index: 1000; width: 100%; border-bottom: 1px solid #d9dee3;"
     id="layout-navbar">

    <div class="navbar-nav-left d-flex align-items-center me-auto">
        <div class="layout-menu-toggle navbar-nav align-items-xl-center me-3 me-xl-0 d-xl-none">
            <a class="nav-item nav-link px-0 me-xl-4" href="javascript:void(0)">
                <i class="bx bx-menu bx-sm"></i>
            </a>
        </div>
        <div class="app-brand demo">
            <a href="/" class="app-brand-link">
                <img src="https://static.vecteezy.com/system/resources/previews/013/077/069/large_2x/open-book-logo-design-template-open-book-illustration-vector.jpg" alt="Logo" width="40" class="app-brand-logo demo" />
                <span class="app-brand-text demo menu-text fw-bolder ms-2 text-capitalize" style="font-size: 1.25rem;">Bookstore Management</span>
            </a>
        </div>
    </div>

    <div class="navbar-nav-right d-flex align-items-center ms-auto" id="navbar-collapse">
        <ul class="navbar-nav flex-row align-items-center ms-auto">

            <li class="nav-item dropdown-notifications navbar-dropdown dropdown me-3 me-xl-2">
                <a class="nav-link dropdown-toggle hide-arrow position-relative"
                   href="javascript:void(0);"
                   data-bs-toggle="dropdown">

                    <i class="bx bx-bell bx-sm"></i>

                    @if (UnreadCount > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            @(UnreadCount > 99 ? "99+" : UnreadCount.ToString())
                        </span>
                    }
                </a>
                <ul class="dropdown-menu dropdown-menu-end py-0" style="width: 350px;">
                    <li class="dropdown-header border-bottom py-3">
                        <span class="fw-semibold">
                            Thông báo (@UnreadCount chưa đọc)
                        </span>
                    </li>

                    @if (Noti.Any())
                    {
                        @foreach (var noti in Noti.OrderByDescending(x => x.CreatedAt))
                        {
                            <li>
                                <a class="dropdown-item py-3"
                                   href="@($"/orders/{noti.OrderId}")">

                                    <div class="d-flex flex-column">

                                        <div class="d-flex justify-content-between">
                                            <span class="fw-semibold">
                                                @noti.Title
                                            </span>

                                            @if (!noti.IsRead)
                                            {
                                                <span class="badge bg-primary">
                                                    Mới
                                                </span>
                                            }
                                        </div>

                                        <small class="text-muted">
                                            @noti.Content
                                        </small>

                                        @if (!string.IsNullOrEmpty(noti.OrderCode))
                                        {
                                            <small class="text-info">
                                                Đơn hàng: @noti.OrderCode
                                            </small>
                                        }

                                        <small class="text-muted mt-1">
                                            @noti.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    </div>

                                </a>
                            </li>
                        }
                    }
                    else
                    {
                        <li>
                            <div class="dropdown-item text-center py-3">
                                Không có thông báo
                            </div>
                        </li>
                    }
                </ul>
            </li>

            <AuthorizeView>
                <Authorized>
                    <li class="nav-item d-flex align-items-center">
                        <div class="avatar avatar-online me-2">
                            <img src="/assets/img/avatars/1.png"
                                 alt="Avatar"
                                 class="w-px-40 h-auto rounded-circle" />
                        </div>

                        <div class="me-3">
                            <span class="fw-semibold d-block text-dark">
                                @context.User.Identity?.Name
                            </span>
                            <small class="text-muted">
                                @GetRoleName(context.User)
                            </small>
                        </div>

                        <button class="btn btn-outline-danger btn-sm"
                                @onclick="Logout">
                            <i class="bx bx-power-off"></i>
                        </button>
                    </li>
                </Authorized>

                <NotAuthorized>
                    <li class="nav-item">
                        <a href="/login" class="btn btn-primary shadow-sm rounded-pill px-4">
                            <i class="bx bx-log-in me-1"></i> Đăng nhập
                        </a>
                    </li>
                </NotAuthorized>
            </AuthorizeView>

        </ul>
    </div>
</nav>

@code {
    
    private List<NotiDto> Noti = new();
    private int UnreadCount => Noti.Count(x => !x.IsRead);

    protected override async Task OnInitializedAsync()
    {
        await LoadNotifications();
    }

    private async Task LoadNotifications()
    {
        var notiDto = await Http.GetFromJsonAsync<List<NotiDto>>("/api/notifications/admin");
        if (notiDto != null)
        {
            Noti = notiDto.OrderByDescending(x => x.CreatedAt).ToList();
        }
    }

    private string GetRoleName(ClaimsPrincipal user)
    {
        // Kiểm tra claim chuẩn của .NET
        var role = user.FindFirst(ClaimTypes.Role)?.Value;

        if (string.IsNullOrEmpty(role))
        {
            role = user.FindFirst("Role")?.Value;
        }

        return string.IsNullOrEmpty(role) ? "Người dùng" : role;
    }

    private void Logout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}