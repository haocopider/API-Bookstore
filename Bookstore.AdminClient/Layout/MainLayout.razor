@inherits LayoutComponentBase

<div class="layout-wrapper layout-content-navbar">
<div class="layout-container">
    <div id="main" class="layout-page">
        <Header/>
        <div class="content-wrapper">
           <div class="container-xxl flex-grow-1 container-p-y">
                @if (isLoading)
                {
                    <div class="d-flex justify-content-center align-items-center" style="height: 60vh;">
                        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (summary != null)
                {
                    @* HEADER: THÔNG TIN SHOP *@
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card text-white mb-3 shadow-sm border-0" style="background: linear-gradient(135deg, #696cff 0%, #888bff 100%);">
                                <div class="card-body p-4">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar avatar-xl me-3 bg-white p-1 rounded-circle shadow-sm" style="width: 80px; height: 80px;">
                                            <img src="https://static.vecteezy.com/system/resources/previews/013/077/069/large_2x/open-book-logo-design-template-open-book-illustration-vector.jpg"
                                                    alt="Logo" class="rounded-circle w-100 h-100 object-fit-cover">
                                        </div>
                                        <div>
                                            <h4 class="text-white fw-bold mb-1">Bookstore 👋</h4>
                                            <p class="mb-0 opacity-75 small">
                                                <i class="bx bx-map me-1"></i> 01 Trần Phú, Tp.Nha Trang, Khánh Hoà <span class="mx-2">|</span>
                                                <i class="bx bx-calendar me-1"></i> 01/12/2000
                                            </p>
                                            <button class="btn btn-primary chat-float-btn shadow-lg" @onclick='() => LoadTab("chat")'>
                                                <i class="bx bx-message-rounded-dots fs-3"></i>

                                                <span class="position-absolute top-0 start-100 translate-middle p-2 bg-danger border border-light rounded-circle">
                                                    <span class="visually-hidden">Tin nhắn mới</span>
                                                </span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* THỐNG KÊ 4 Ô *@
                    <div class="row g-4 mb-4">
                        @* Ô 1: Doanh thu tháng *@
                        <div class="col-lg-3 col-md-6 col-6">
                            <div class="card shadow-sm h-100 border-0">
                                <div class="card-body">
                                    <div class="card-title d-flex align-items-start justify-content-between">
                                        <div class="avatar flex-shrink-0">
                                            <span class="avatar-initial rounded bg-label-success"><i class="bx bx-wallet"></i></span>
                                        </div>
                                    </div>
                                    <span class="fw-semibold d-block mb-1 text-muted">Doanh thu tháng này</span>
                                    <h4 class="card-title mb-2 text-success">@summary.CurrentMonthRevenue.ToString("N0") <small>đ</small></h4>

                                    @if (summary.RevenueGrowth >= 0)
                                    {
                                        <small class="text-success fw-semibold"><i class='bx bx-up-arrow-alt'></i> +@summary.RevenueGrowth.ToString("N1")%</small>
                                    }
                                    else
                                    {
                                        <small class="text-danger fw-semibold"><i class='bx bx-down-arrow-alt'></i> @summary.RevenueGrowth.ToString("N1")%</small>
                                    }
                                </div>
                            </div>
                        </div>

                        @* Ô 2: Đơn hàng *@
                        <div class="col-lg-3 col-md-6 col-6">
                            <div class="card shadow-sm h-100 border-0">
                                <div class="card-body">
                                    <div class="card-title d-flex align-items-start justify-content-between">
                                        <div class="avatar flex-shrink-0">
                                            <span class="avatar-initial rounded bg-label-primary"><i class="bx bx-cart"></i></span>
                                        </div>
                                    </div>
                                    <span class="fw-semibold d-block mb-1 text-muted">Đơn hàng mới</span>
                                    <h4 class="card-title mb-2">@summary.CurrentMonthOrders</h4>
                                    @if (summary.OrderGrowth >= 0)
                                    {
                                        <small class="text-success fw-semibold"><i class='bx bx-up-arrow-alt'></i> +@summary.OrderGrowth.ToString("N1")%</small>
                                    }
                                    else
                                    {
                                        <small class="text-danger fw-semibold"><i class='bx bx-down-arrow-alt'></i> @summary.OrderGrowth.ToString("N1")%</small>
                                    }
                                </div>
                            </div>
                        </div>

                        @* Ô 3: Sản phẩm bán ra *@
                        <div class="col-lg-3 col-md-6 col-6">
                            <div class="card shadow-sm h-100 border-0">
                                <div class="card-body">
                                    <div class="card-title d-flex align-items-start justify-content-between">
                                        <div class="avatar flex-shrink-0">
                                            <span class="avatar-initial rounded bg-label-warning"><i class="bx bx-package"></i></span>
                                        </div>
                                    </div>
                                    <span class="fw-semibold d-block mb-1 text-muted">SP đã bán tháng này</span>
                                    <h4 class="card-title mb-2">@summary.TotalProductsSold</h4>
                                    <small class="text-muted">Đang kinh doanh: <strong>@summary.TotalActiveProducts</strong> SP</small>
                                </div>
                            </div>
                        </div>

                        @* Ô 4: Khách hàng *@
                        <div class="col-lg-3 col-md-6 col-6">
                            <div class="card shadow-sm h-100 border-0">
                                <div class="card-body">
                                    <div class="card-title d-flex align-items-start justify-content-between">
                                        <div class="avatar flex-shrink-0">
                                            <span class="avatar-initial rounded bg-label-info"><i class="bx bx-user-voice"></i></span>
                                        </div>
                                    </div>
                                    <span class="fw-semibold d-block mb-1 text-muted">Người dùng</span>
                                    <h4 class="card-title mb-2">@summary.TotalFollowers</h4>
                                    <small class="text-muted">Tổng quan</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* MAIN CONTENT *@
                    <div class="row">
                        @* --- KHU VỰC TRUNG TÂM (Biểu đồ hoặc List) --- *@
                        <div class="col-lg-9 mb-4">
                            <div class="card mb-4 shadow-sm border-0">
                                @Body
                            </div>
                        </div>

                        @* --- SIDEBAR QUẢN LÝ NHANH --- *@
                        <div class="col-lg-3 mb-4">
                            <div class="card h-100 shadow-sm border-0">
                                <div class="card-header d-flex align-items-center justify-content-between">
                                    <h5 class="card-title m-0 me-2 fw-bold"><i class="bx bx-grid-alt me-2 text-primary"></i>Truy cập nhanh</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row g-3">
                                        @* 1. Biểu đồ *@
                                        <div class="col-6">
                                            <a @onclick='() => LoadTab("")'
                                                class="d-flex flex-column align-items-center justify-content-center border rounded p-3 text-decoration-none transition-all h-100
                                                @(activeTab == "" ? "pe-none border-secondary bg-label-secondary shadow-sm" : "bg-label-hover-secondary cursor-pointer")">
                                                <i class="bx bx-bar-chart-alt fs-1 mb-2 text-secondary"></i>
                                                <span class="fw-bold text-dark small">Biểu đồ</span>
                                            </a>
                                        </div>

                                        @* 2. Sản phẩm *@
                                        <div class="col-6">
                                            <a @onclick='() => LoadTab("products")'
                                                class="d-flex flex-column align-items-center justify-content-center border rounded p-3 text-decoration-none transition-all h-100
                                                @(activeTab == "products" ? "pe-none border-primary bg-label-primary shadow-sm" : "bg-label-hover-primary cursor-pointer")">
                                                <i class="bx bx-package fs-1 mb-2 text-primary"></i>
                                                <span class="fw-bold text-dark small">Sản phẩm</span>
                                            </a>
                                        </div>

                                        @* 3. Khuyến mãi *@
                                        <div class="col-6">
                                            <a @onclick='() => LoadTab("promotions")'
                                                class="d-flex flex-column align-items-center justify-content-center border rounded p-3 text-decoration-none transition-all h-100
                                                @(activeTab == "promotions" ? "pe-none border-warning bg-label-warning shadow-sm" : "bg-label-hover-warning cursor-pointer")">
                                                <i class="bx bx-gift fs-1 mb-2 text-warning"></i>
                                                <span class="fw-bold text-dark small">Khuyến mãi</span>
                                            </a>
                                        </div>

                                        @* 4. Đơn hàng *@
                                        <div class="col-6">
                                            <a @onclick='() => LoadTab("orders")'
                                                class="d-flex flex-column align-items-center justify-content-center border rounded p-3 text-decoration-none transition-all h-100
                                                @(activeTab == "orders" ? "pe-none border-success bg-label-success shadow-sm" : "bg-label-hover-success cursor-pointer")">
                                                <i class="bx bx-cart fs-1 mb-2 text-success"></i>
                                                <span class="fw-bold text-dark small">Đơn hàng</span>
                                            </a>
                                        </div>

                                        @* 5. Tác giả *@
                                        <div class="col-6">
                                            <a @onclick='() => LoadTab("authors")'
                                                class="d-flex flex-column align-items-center justify-content-center border rounded p-3 text-decoration-none transition-all h-100
                                                @(activeTab == "authors" ? "pe-none border-primary bg-label-primary shadow-sm" : "bg-label-hover-primary cursor-pointer")">
                                                <i class="bx bx-user-pin fs-1 mb-2 text-primary"></i>
                                                <span class="fw-bold text-dark small">Tác giả</span>
                                            </a>
                                        </div>

                                        @* 6. Thể loại *@
                                        <div class="col-6">
                                            <a @onclick='() => LoadTab("categories")'
                                                class="d-flex flex-column align-items-center justify-content-center border rounded p-3 text-decoration-none transition-all h-100
                                                @(activeTab == "categories" ? "pe-none border-info bg-label-info shadow-sm" : "bg-label-hover-info cursor-pointer")">
                                                <i class="bx bx-category fs-1 mb-2 text-info"></i>
                                                <span class="fw-bold text-dark small">Thể loại</span>
                                            </a>
                                        </div>

                                        @* 7. Nhân sự *@
                                        <div class="col-6">
                                            <a @onclick='() => LoadTab("staff")'
                                                class="d-flex flex-column align-items-center justify-content-center border rounded p-3 text-decoration-none transition-all h-100
                                                @(activeTab == "staff" ? "pe-none border-danger bg-label-danger shadow-sm" : "bg-label-hover-danger cursor-pointer")">
                                                <i class="bx bx-group fs-1 mb-2 text-danger"></i>
                                                <span class="fw-bold text-dark small">Nhân sự</span>
                                            </a>
                                        </div>

                                        @* 8. Phân quyền *@
                                        <div class="col-6">
                                            <a @onclick='() => LoadTab("roles")'
                                                class="d-flex flex-column align-items-center justify-content-center border rounded p-3 text-decoration-none transition-all h-100
                                                @(activeTab == "roles" ? "pe-none border-secondary bg-label-secondary shadow-sm" : "bg-label-hover-secondary cursor-pointer")">
                                                <i class="bx bx-shield-quarter fs-1 mb-2 text-secondary"></i>
                                                <span class="fw-bold text-dark small">Phân quyền</span>
                                            </a>
                                        </div>
                                    </div>

                                    <div class="mt-4">
                                        <h6 class="text-muted text-uppercase small fw-bold mb-3">Thông báo mới</h6>
                                        <ul class="list-group list-group-flush">
                                            <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 pb-0">
                                                <span><i class="bx bx-bell me-2 text-warning"></i> 3 đơn hàng mới</span>
                                                <small class="text-muted">Nay</small>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

           </div>
           <Footer />
        </div>
    </div>
        
</div>
</div>

<Toast />

<style>
    .cursor-pointer {
        cursor: pointer;
    }

    .bg-label-hover-primary:hover {
        background-color: #e7e7ff !important;
        border-color: #696cff !important;
    }

    .bg-label-hover-success:hover {
        background-color: #e8fadf !important;
        border-color: #71dd37 !important;
    }

    .bg-label-hover-info:hover {
        background-color: #d7f5fc !important;
        border-color: #03c3ec !important;
    }

    .bg-label-hover-warning:hover {
        background-color: #fff2d6 !important;
        border-color: #ffab00 !important;
    }

    .transition-all {
        transition: all 0.2s ease-in-out;
    }

    .object-fit-cover {
        object-fit: cover;
    }

    /* Nút chat trôi nổi (Floating Button) */
    .chat-float-btn {
        position: fixed;
        bottom: 30px; /* Cách lề dưới 30px */
        right: 30px; /* Cách lề phải 30px */
        width: 60px; /* Chiều rộng nút */
        height: 60px; /* Chiều cao nút */
        border-radius: 50%; /* Bo tròn hoàn toàn */
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050; /* Đảm bảo nút luôn nổi lên trên các thành phần khác */
        transition: all 0.3s ease; /* Hiệu ứng chuyển động mượt mà */
    }

        /* Hiệu ứng khi di chuột vào nút */
        .chat-float-btn:hover {
            transform: scale(1.1); /* Phóng to nút lên 10% */
            cursor: pointer;
        }
</style>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSR.InvokeVoidAsync("initSneatLayout");
        }
    }

    private bool isLoading = true;
    private string activeTab = "chart";

    private MonthlyRevenueDto summary;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardSummary();
    }

    private async Task LoadDashboardSummary()
    {
        isLoading = true;
        try
        {
            summary = await Http.GetFromJsonAsync<MonthlyRevenueDto>("api/statistics/dashboard-summary");
        }
        catch (Exception ex)
        {
            Console.WriteLine("Lỗi tải dữ liệu tổng quan: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadTab(string tabName)
    {
        activeTab = tabName;
        Navigation.NavigateTo($"{tabName}", false);
    }
}